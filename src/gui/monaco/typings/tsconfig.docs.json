{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "noEmit": true,
  },
  "include": [
    "./*.d.ts"
  ],
  "typedocOptions": {
    // typedoc's defaults plus @mcp: that text is only for the MCP tool
    // descriptions (see scripts/gen-hook-spec.js)
    "excludeTags": [
      "@override",
      "@virtual",
      "@privateRemarks",
      "@satisfies",
      "@overload",
      "@inline",
      "@inlineType",
      "@mcp"
    ]
  }
}
